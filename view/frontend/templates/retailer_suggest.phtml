<?php
/** @var \Smile\ElasticsuiteRetailer\Block\Suggest $block */
/** @var \Magento\Framework\Escaper $escaper */
?>
<?php if ($block->canShowBlock()): ?>
    <div class="search results">
        <h2><?= $escaper->escapeHtml(__('Results in retailers.')) ?></h2>

        <ul>
            <?php foreach ($block->getRetailerCollection() as $currentRetailer): ?>
                <li>
                    <a href="<?= $escaper->escapeUrl($block->getRetailerUrl($currentRetailer)) ?>">
                        <?= $escaper->escapeHtml($currentRetailer->getName()) ?>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
        <a href="<?= $escaper->escapeUrl($block->getShowAllUrl()) ?>"><?= $escaper->escapeHtml(__('Show more.')) ?></a>
    </div>
<?php endif; ?>